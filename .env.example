# Copy to .env.local for development. Analytics runs only on the Vercel production deployment (gated
# on the auto-injected NEXT_PUBLIC_VERCEL_ENV), so nothing here is needed to develop locally. Set the
# two PostHog values in the Vercel project.

# PostHog project API key (leave empty to disable analytics)
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog ingest host (EU cloud shown; use https://us.i.posthog.com for US)
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
